<?xml version="1.0" encoding="UTF-8"?>
<!--
  xfs-win-driver MSI source — WiX 4+.

  Build via `installer/build.ps1` (which shells out to `wix build`).
  The build script passes:
    -d ExePath=<path to xfs.exe>     (PATH to the release binary)
    -d Version=<x.y.z>                (from Cargo.toml; default 0.1.0)

  Stable UpgradeCode — DO NOT regenerate on every build, or major-upgrade
  detection breaks. Generated as a v4 UUID for this product line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="xfs-win-driver"
      Manufacturer="Chris Thomas"
      Version="$(var.Version)"
      UpgradeCode="10e72b63-3bd8-430c-8998-4ec40db7646e"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation
        Description="xfs-win-driver — browse and mount xfs volumes on Windows"
        Manufacturer="Chris Thomas" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Major upgrade: silently uninstall older versions. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of xfs-win-driver is already installed." />

    <!--
      WinFsp is no longer detected here — the Burn bootstrapper
      (Bundle.wxs) chains the WinFsp MSI ahead of this one, so by the time
      we run, WinFsp is guaranteed present. Stand-alone MSI installs
      (admins deploying via SCCM/Intune) are expected to push WinFsp
      separately as part of the same package.
    -->

    <Feature Id="Main" Title="xfs-win-driver" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="WinFspLauncherComponents" />
      <ComponentGroupRef Id="ContextMenuComponents" />
      <ComponentGroupRef Id="StartMenuComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="xfs-win-driver" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="xfs-win-driver" />
    </StandardDirectory>

    <!-- ====================================================================
         Main payload: xfs.exe, the helper PowerShell script, the LICENSE.
         ==================================================================== -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <Component Id="XfsExe" Guid="*">
        <File
            Id="XfsExeFile"
            Source="$(var.ExePath)"
            KeyPath="yes"
            Name="xfs.exe" />
        <!--
          XfsWatcher service. The binary, when invoked with the `service`
          argument, enters Windows-service mode and registers with SCM under
          this name. Account=LocalSystem because the watcher signals
          WinFsp.Launcher (which expects an elevated caller) and needs to
          resolve volume devices in any session. <ServiceControl> guarantees
          stop+remove on uninstall and major-upgrade.

          Start=auto is not what the running service should be. A watcher
          that enumerates every disk and asks the launcher to publish volumes
          belongs after the boot-critical work, and the live service is
          configured Automatic (Delayed Start): `sc config XfsWatcher
          start= delayed-auto` leaves Start=2 plus DelayedAutostart=1 under
          the service key, which is
          SERVICE_CONFIG_DELAYED_AUTO_START_INFO -- a ChangeServiceConfig2
          call, not a column of the MSI Services table. So `Start="auto"`
          here can only ever mean plain automatic, and the gap is real rather
          than cosmetic. Closing it needs the WiX element for delayed start or
          a deferred custom action running `sc config` -- not guessed markup
          into a component that runs as LocalSystem, so it is left to a run
          where the WiX toolset is installed and the XML actually compiles.

          WiX 7 note: <ServiceInstall> + <ServiceControl> are direct
          children of <Component>, not nested inside <File> (the WiX 4/5
          shorthand). They reference the component's keyfile implicitly.
        -->
        <ServiceInstall
            Id="XfsWatcherSvc"
            Type="ownProcess"
            Name="XfsWatcher"
            DisplayName="xfs-win-driver auto-mount watcher"
            Description="Watches for xfs volumes plugging in and asks WinFsp.Launcher to mount them in the active user session."
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
            Vital="yes"
            Arguments="service" />
        <ServiceControl
            Id="XfsWatcherSvcCtl"
            Name="XfsWatcher"
            Start="install"
            Stop="both"
            Remove="both"
            Wait="yes" />
        <!--
          PATH update via WixUtilExtension. System=yes writes to the machine
          PATH (we're a perMachine install). Action=set + Part=last appends
          INSTALLFOLDER. The element is automatically reversed on uninstall.
        -->
        <Environment
            Id="PathEnv"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
      </Component>

      <Component Id="MountScript" Guid="*">
        <File
            Id="MountScriptFile"
            Source="Mount-Xfs.ps1"
            KeyPath="yes"
            Name="Mount-Xfs.ps1" />
      </Component>

      <Component Id="LicenseFile" Guid="*">
        <File
            Id="LicenseFileF"
            Source="LICENSE"
            KeyPath="yes"
            Name="LICENSE.txt" />
      </Component>

    </ComponentGroup>

    <!-- ====================================================================
         WinFsp.Launcher service-class registration.

         WinFsp.Launcher reads HKLM\SOFTWARE\WinFsp\Services\<class>\… to find
         out how to spawn FS-mount helpers. We register the `xfs-mount` class
         here so XfsWatcher (and ad-hoc CLI users) can ask the launcher to
         spawn the `mount %2 [drive %1]` invocation on demand (see CommandLine
         below for the literal template).

         CommandLine template:
           %1 -> drive letter argument
           %2 -> disk device path argument (e.g. \\?\STORAGE#Disk#...)
           %3 -> 1-indexed partition number, or "0" for whole-disk
         JobControl=1 -> kill the helper if launcher dies.
         Credentials=0 -> no per-call auth handshake (FS doesn't need creds).
         Security DACL D:P(A;;RPWPLC;;;WD) -> Everyone can Start/Stop/List.
           Mirrors sshfs-win and rclone's defaults; fine for a mount helper.

         The Burn bundle (Bundle.wxs) chains the WinFsp MSI ahead of this one,
         so the WinFsp.Launcher service is up by the time these registry
         values are read. Stand-alone MSI installs must push WinFsp
         separately — the keys are still valid, just inert until then.
         ==================================================================== -->
    <ComponentGroup Id="WinFspLauncherComponents" Directory="INSTALLFOLDER">

      <Component Id="WinFspLauncherRegistration" Guid="*" Bitness="always32">
        <!--
          Bitness="always32" forces the registration into the
          WOW6432Node view of the registry. WinFsp.Launcher is a
          32-bit service: it reads `HKLM\SOFTWARE\WinFsp\Services\...`
          from its own 32-bit context, which Windows redirects to
          `HKLM\SOFTWARE\WOW6432Node\WinFsp\Services\...`. Without
          always32 our 64-bit MSI writes to the 64-bit view of the
          key and the launcher can't see it: spawning a mount fails
          with NTSTATUS c0000034 OBJECT_NAME_NOT_FOUND.
        -->
        <RegistryKey
            Root="HKLM"
            Key="SOFTWARE\WinFsp\Services\xfs-mount"
            ForceDeleteOnUninstall="yes">
          <RegistryValue
              Type="string"
              Name="Executable"
              Value="[INSTALLFOLDER]xfs.exe"
              KeyPath="yes" />
          <RegistryValue
              Type="string"
              Name="CommandLine"
              Value="mount %2 --drive %1 --part %3 --ro" />
          <RegistryValue
              Type="string"
              Name="WorkDirectory"
              Value="[INSTALLFOLDER]" />
          <RegistryValue
              Type="integer"
              Name="JobControl"
              Value="1" />
          <RegistryValue
              Type="integer"
              Name="Credentials"
              Value="0" />
          <RegistryValue
              Type="string"
              Name="Security"
              Value="D:P(A;;RPWPLC;;;WD)" />
        </RegistryKey>
      </Component>

    </ComponentGroup>

    <!-- ====================================================================
         Explorer right-click context menu on .img files.

         We attach to SystemFileAssociations\.img (a verb-only key that doesn't
         override the user's default association — Disk Management's built-in
         Mount verb keeps working for VHD/ISO).

         Components live under INSTALLFOLDER so KeyPath can sit on a registry
         value. Each Component MUST have exactly one KeyPath.
         ==================================================================== -->
    <ComponentGroup Id="ContextMenuComponents" Directory="INSTALLFOLDER">

      <Component Id="ContextMenuVerb" Guid="*">
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.img\shell\MountAsXfs">
          <RegistryValue
              Type="string"
              Value="Mount as xfs"
              KeyPath="yes" />
          <!--
            Icon: point at the EXE's first embedded icon resource (index 0).
            "<path>,0" is the canonical shell-icon-spec form; do not quote.
          -->
          <RegistryValue
              Name="Icon"
              Type="string"
              Value="[INSTALLFOLDER]xfs.exe,0" />
        </RegistryKey>
      </Component>

      <Component Id="ContextMenuCommand" Guid="*">
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.img\shell\MountAsXfs\command">
          <RegistryValue
              Type="string"
              Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Mount-Xfs.ps1&quot; &quot;%1&quot;"
              KeyPath="yes" />
        </RegistryKey>
      </Component>

    </ComponentGroup>

    <!-- ====================================================================
         Start Menu shortcuts.

         Per-user state is captured via a HKCU registry KeyPath sentinel —
         that's the canonical way to give a per-machine install a per-user
         shortcut component (otherwise ICE38/ICE43 fire).
         ==================================================================== -->
    <ComponentGroup Id="StartMenuComponents" Directory="ApplicationProgramsFolder">

      <Component Id="StartMenuShortcuts" Guid="*">
        <Shortcut
            Id="MountImgShortcut"
            Name="Mount xfs image..."
            Description="Pick an xfs .img file and mount it as a Windows drive letter."
            Target="powershell.exe"
            Arguments="-NoExit -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Mount-Xfs.ps1&quot;"
            WorkingDirectory="INSTALLFOLDER"
            Icon="xfsIcon.exe"
            IconIndex="0" />
        <Shortcut
            Id="WatchShortcut"
            Name="xfs watch service"
            Description="Run the xfs watch service in a console (Ctrl-C to stop)."
            Target="[INSTALLFOLDER]xfs.exe"
            Arguments="watch"
            WorkingDirectory="INSTALLFOLDER"
            Icon="xfsIcon.exe"
            IconIndex="0" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\xfs-win-driver"
            Name="StartMenuShortcuts"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- Icon source for the shortcuts (re-uses the EXE's embedded icon, if any). -->
    <Icon Id="xfsIcon.exe" SourceFile="$(var.ExePath)" />
    <Property Id="ARPPRODUCTICON" Value="xfsIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/christhomas/xfs-win-driver" />
    <Property Id="ARPHELPLINK" Value="https://winfsp.dev/" />

  </Package>
</Wix>
